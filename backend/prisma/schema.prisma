generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  userType      UserType
  mobile        String         @unique
  email         String?
  status        UserStatus     @default(ACTIVE)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  admin         AdminUser?
  authSessions  AuthSession[]
  customer      Customer?
  driver        Driver?
  notifications Notification[]

  @@index([userType, status])
}

model Customer {
  id                String                 @id @default(cuid())
  userId            String                 @unique
  fullName          String
  photoUrl          String?
  referralCode      String?                @unique
  rating            Float                  @default(5)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  bookings          Booking[]
  couponUsages      CouponUsage[]
  user              User                   @relation(fields: [userId], references: [id])
  photos            CustomerGalleryPhoto[]
  emergencyContacts EmergencyContact[]
  payments          Payment[]
  ratings           Rating[]
  sosEvents         SosEvent[]
  supportCases      SupportCase[]
  tripPassengers    TripPassenger[]
}

model CustomerGalleryPhoto {
  id         String             @id @default(cuid())
  customerId String
  uri        String
  source     GalleryPhotoSource @default(CAMERA)
  fileName   String?
  mimeType   String?
  uploaded   Boolean            @default(false)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  customer   Customer           @relation(fields: [customerId], references: [id])

  @@index([customerId, createdAt])
}

model EmergencyContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  mobile     String
  relation   String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([customerId, isPrimary])
}

model Driver {
  id                   String                   @id @default(cuid())
  userId               String                   @unique
  fullName             String
  photoUrl             String?
  address              String?
  verificationStatus   DriverVerificationStatus @default(PENDING)
  driverStatus         DriverStatus             @default(OFFLINE)
  dailyServiceMode     ServiceMode              @default(BOTH)
  serviceModeUpdatedAt DateTime?
  rating               Float                    @default(5)
  totalRides           Int                      @default(0)
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  assignedBookings     Booking[]                @relation("BookingDriver")
  bookingLegs          BookingLeg[]
  cashCollections      CashCollection[]
  commissionEntries    CommissionEntry[]
  user                 User                     @relation(fields: [userId], references: [id])
  documents            DriverDocument[]
  earnings             DriverEarning[]
  location             DriverLocation?
  settlements          DriverSettlement[]
  financialAdjustments FinancialAdjustment[]
  ledgerEntries        LedgerEntry[]
  ratings              Rating[]
  rideRequests         RideRequest[]
  sosEvents            SosEvent[]
  supportCases         SupportCase[]
  vehicles             Vehicle[]

  @@index([verificationStatus, driverStatus])
}

model DriverDocument {
  id              String                   @id @default(cuid())
  driverId        String
  documentType    String
  documentNumber  String?
  fileUrl         String?
  status          DriverVerificationStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  driver          Driver                   @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
}

model Vehicle {
  id            String        @id @default(cuid())
  driverId      String
  vehicleType   VehicleType   @default(E_RICKSHAW)
  vehicleNumber String        @unique
  capacity      Int           @default(4)
  goodsEligible Boolean       @default(false)
  status        VehicleStatus @default(PENDING)
  photoUrl      String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  bookings      Booking[]
  bookingLegs   BookingLeg[]
  rideRequests  RideRequest[]
  driver        Driver        @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
  @@index([vehicleType, status])
}

model DriverLocation {
  id         String   @id @default(cuid())
  driverId   String   @unique
  latitude   Float
  longitude  Float
  accuracy   Float?
  heading    Float?
  speed      Float?
  isOnline   Boolean  @default(false)
  recordedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt
  driver     Driver   @relation(fields: [driverId], references: [id])
}

model QuickLocation {
  id        String   @id @default(cuid())
  name      String
  category  String
  photoUrl  String?
  address   String
  city      String   @default("Katihar")
  latitude  Float
  longitude Float
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, active])
}

model Booking {
  id                    String                @id @default(cuid())
  customerId            String
  bookingType           BookingType           @default(RIDE)
  rideType              RideType?
  status                BookingStatus         @default(NEW)
  pickupAddress         String
  pickupLat             Float
  pickupLng             Float
  dropAddress           String
  dropLat               Float
  dropLng               Float
  passengerCount        Int                   @default(1)
  pickupDatetime        DateTime?
  timezone              String?
  isScheduled           Boolean               @default(false)
  estimatedFare         Decimal?              @db.Decimal(12, 2)
  finalFare             Decimal?              @db.Decimal(12, 2)
  pricingVersion        String?
  commissionRate        Decimal?              @db.Decimal(6, 4)
  paymentPreference     PaymentMethod?
  goodsVehicleType      VehicleType?
  goodsType             String?
  goodsWeightKg         Float?
  goodsSize             GoodsSize?
  receiverName          String?
  receiverMobile        String?
  loadingInstructions   String?
  unloadingInstructions String?
  waitingMinutes        Int                   @default(0)
  specialInstructions   String?
  stops                 Json?
  driverArrivedAt       DateTime?
  pickupWaitExpiresAt   DateTime?
  autoCancelledAt       DateTime?
  cancelReason          String?
  rebookOfId            String?
  assignedDriverId      String?
  vehicleId             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  couponId              String?
  couponCode            String?
  couponDiscount        Decimal               @default(0) @db.Decimal(12, 2)
  dropLocationImageUrl  String?
  assignedDriver        Driver?               @relation("BookingDriver", fields: [assignedDriverId], references: [id])
  coupon                Coupon?               @relation(fields: [couponId], references: [id])
  customer              Customer              @relation(fields: [customerId], references: [id])
  parentBooking         Booking?              @relation("Rebook", fields: [rebookOfId], references: [id])
  rebookings            Booking[]             @relation("Rebook")
  vehicle               Vehicle?              @relation(fields: [vehicleId], references: [id])
  legs                  BookingLeg[]
  cashCollections       CashCollection[]
  commissionEntries     CommissionEntry[]
  couponUsage           CouponUsage?
  driverEarnings        DriverEarning[]
  financialAdjustments  FinancialAdjustment[]
  ledgerEntries         LedgerEntry[]
  payment               Payment?
  paymentAttempts       PaymentAttempt[]
  paymentTransactions   PaymentTransaction[]
  ratings               Rating[]
  refunds               Refund[]
  rideRequests          RideRequest[]
  routes                Route[]
  sosEvents             SosEvent[]
  supportCases          SupportCase[]
  tripPassengers        TripPassenger[]

  @@index([customerId, createdAt])
  @@index([status, bookingType, rideType])
  @@index([assignedDriverId, status])
}

model BookingLeg {
  id            String        @id @default(cuid())
  bookingId     String
  sequence      Int
  status        BookingStatus @default(NEW)
  pickupAddress String
  pickupLat     Float
  pickupLng     Float
  dropAddress   String
  dropLat       Float
  dropLng       Float
  driverId      String?
  vehicleId     String?
  estimatedFare Decimal?      @db.Decimal(12, 2)
  finalFare     Decimal?      @db.Decimal(12, 2)
  tripPin       String?
  tripId        String?       @unique
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  booking       Booking       @relation(fields: [bookingId], references: [id])
  driver        Driver?       @relation(fields: [driverId], references: [id])
  trip          Trip?         @relation(fields: [tripId], references: [id])
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  rideRequests  RideRequest[]
  routes        Route[]

  @@unique([bookingId, sequence])
  @@index([driverId, status])
}

model RideRequest {
  id          String            @id @default(cuid())
  bookingId   String
  legId       String?
  driverId    String
  vehicleId   String
  distanceKm  Float?
  etaMinutes  Int?
  score       Float?
  offeredAt   DateTime          @default(now())
  respondedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  status      RideRequestStatus @default(OFFERED)
  booking     Booking           @relation(fields: [bookingId], references: [id])
  driver      Driver            @relation(fields: [driverId], references: [id])
  leg         BookingLeg?       @relation(fields: [legId], references: [id])
  vehicle     Vehicle           @relation(fields: [vehicleId], references: [id])

  @@index([driverId, status])
  @@index([bookingId, status])
  @@index([expiresAt])
}

model Trip {
  id          String              @id @default(cuid())
  status      BookingStatus       @default(NEW)
  tripPin     String
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  bookingLeg  BookingLeg?
  locations   TripLocationEvent[]

  @@index([status, startedAt])
}

model TripLocationEvent {
  id         String   @id @default(cuid())
  tripId     String
  latitude   Float
  longitude  Float
  accuracy   Float?
  recordedAt DateTime @default(now())
  heading    Float?
  speed      Float?
  trip       Trip     @relation(fields: [tripId], references: [id])

  @@index([tripId, recordedAt])
}

model TripPassenger {
  id              String    @id @default(cuid())
  bookingId       String
  customerId      String?
  passengerName   String?
  passengerMobile String?
  seatCount       Int       @default(1)
  status          String    @default("WAITING_FOR_PICKUP")
  boardedAt       DateTime?
  droppedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  booking         Booking   @relation(fields: [bookingId], references: [id])
  customer        Customer? @relation(fields: [customerId], references: [id])

  @@index([bookingId, status])
}

model Route {
  id              String      @id @default(cuid())
  bookingId       String
  legId           String?
  distanceKm      Float?
  durationMinutes Int?
  geometry        Json?
  provider        String?
  calculatedAt    DateTime    @default(now())
  booking         Booking     @relation(fields: [bookingId], references: [id])
  leg             BookingLeg? @relation(fields: [legId], references: [id])

  @@index([bookingId, calculatedAt])
}

model Payment {
  id                String               @id @default(cuid())
  bookingId         String               @unique
  customerId        String
  amount            Decimal              @db.Decimal(12, 2)
  method            PaymentMethod
  status            PaymentStatus        @default(PENDING)
  provider          String?
  providerPaymentId String?
  paidAt            DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  ledgerEntries     LedgerEntry[]
  booking           Booking              @relation(fields: [bookingId], references: [id])
  customer          Customer             @relation(fields: [customerId], references: [id])
  attempts          PaymentAttempt[]
  transactions      PaymentTransaction[]
  refunds           Refund[]

  @@index([customerId, createdAt])
}

model PaymentAttempt {
  id                String               @id @default(cuid())
  bookingId         String
  paymentId         String?
  provider          String?
  method            PaymentMethod
  amount            Decimal              @db.Decimal(12, 2)
  status            PaymentAttemptStatus @default(CREATED)
  providerAttemptId String?
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  booking           Booking              @relation(fields: [bookingId], references: [id])
  payment           Payment?             @relation(fields: [paymentId], references: [id])

  @@index([bookingId, createdAt])
}

model PaymentTransaction {
  id                    String        @id @default(cuid())
  bookingId             String
  paymentId             String?
  provider              String?
  transactionType       String
  providerTransactionId String?
  amount                Decimal       @db.Decimal(12, 2)
  status                PaymentStatus @default(PENDING)
  rawReference          String?
  createdAt             DateTime      @default(now())
  booking               Booking       @relation(fields: [bookingId], references: [id])
  payment               Payment?      @relation(fields: [paymentId], references: [id])

  @@index([bookingId, createdAt])
  @@index([providerTransactionId])
}

model Refund {
  id               String       @id @default(cuid())
  bookingId        String
  paymentId        String?
  amount           Decimal      @db.Decimal(12, 2)
  reason           String?
  status           RefundStatus @default(REQUESTED)
  providerRefundId String?
  requestedAt      DateTime     @default(now())
  processedAt      DateTime?
  booking          Booking      @relation(fields: [bookingId], references: [id])
  payment          Payment?     @relation(fields: [paymentId], references: [id])

  @@index([bookingId, status])
}

model DriverEarning {
  id           String            @id @default(cuid())
  bookingId    String
  driverId     String
  grossFare    Decimal           @db.Decimal(12, 2)
  commission   Decimal           @db.Decimal(12, 2)
  netEarning   Decimal           @db.Decimal(12, 2)
  status       EarningStatus     @default(PENDING)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  settlementId String?
  booking      Booking           @relation(fields: [bookingId], references: [id])
  driver       Driver            @relation(fields: [driverId], references: [id])
  settlement   DriverSettlement? @relation(fields: [settlementId], references: [id])

  @@unique([bookingId, driverId])
  @@index([driverId, status])
}

model DriverSettlement {
  id          String           @id @default(cuid())
  driverId    String
  amount      Decimal          @db.Decimal(12, 2)
  status      SettlementStatus @default(PENDING)
  reference   String?
  processedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  earnings    DriverEarning[]
  driver      Driver           @relation(fields: [driverId], references: [id])

  @@index([driverId, status])
}

model LedgerEntry {
  id          String          @id @default(cuid())
  bookingId   String?
  driverId    String?
  paymentId   String?
  type        LedgerEntryType
  direction   LedgerDirection
  amount      Decimal         @db.Decimal(12, 2)
  description String?
  createdAt   DateTime        @default(now())
  referenceId String?
  booking     Booking?        @relation(fields: [bookingId], references: [id])
  driver      Driver?         @relation(fields: [driverId], references: [id])
  payment     Payment?        @relation(fields: [paymentId], references: [id])

  @@index([bookingId, createdAt])
  @@index([driverId, createdAt])
}

model CashCollection {
  id          String   @id @default(cuid())
  bookingId   String
  driverId    String
  amount      Decimal  @db.Decimal(12, 2)
  collectedAt DateTime @default(now())
  verified    Boolean  @default(false)
  booking     Booking  @relation(fields: [bookingId], references: [id])
  driver      Driver   @relation(fields: [driverId], references: [id])

  @@index([driverId, collectedAt])
}

model CommissionEntry {
  id        String   @id @default(cuid())
  bookingId String
  driverId  String?
  grossFare Decimal  @db.Decimal(12, 2)
  rate      Decimal  @db.Decimal(6, 4)
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  driver    Driver?  @relation(fields: [driverId], references: [id])

  @@index([bookingId, createdAt])
}

model FinancialAdjustment {
  id               String   @id @default(cuid())
  bookingId        String?
  driverId         String?
  type             String
  amount           Decimal  @db.Decimal(12, 2)
  reason           String
  createdByAdminId String?
  createdAt        DateTime @default(now())
  booking          Booking? @relation(fields: [bookingId], references: [id])
  driver           Driver?  @relation(fields: [driverId], references: [id])

  @@index([bookingId, createdAt])
}

model Rating {
  id         String       @id @default(cuid())
  bookingId  String
  customerId String
  driverId   String?
  target     RatingTarget @default(RIDE)
  stars      Int
  comment    String?
  createdAt  DateTime     @default(now())
  booking    Booking      @relation(fields: [bookingId], references: [id])
  customer   Customer     @relation(fields: [customerId], references: [id])
  driver     Driver?      @relation(fields: [driverId], references: [id])

  @@unique([bookingId, customerId, target])
  @@index([driverId, createdAt])
}

model SupportCase {
  id              String           @id @default(cuid())
  bookingId       String?
  customerId      String?
  subject         String
  description     String
  status          SupportStatus    @default(OPEN)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  assignedAdminId String?
  driverId        String?
  priority        SupportPriority  @default(NORMAL)
  booking         Booking?         @relation(fields: [bookingId], references: [id])
  customer        Customer?        @relation(fields: [customerId], references: [id])
  driver          Driver?          @relation(fields: [driverId], references: [id])
  messages        SupportMessage[]

  @@index([status, priority])
  @@index([customerId, createdAt])
  @@index([driverId, createdAt])
}

model SupportMessage {
  id            String      @id @default(cuid())
  caseId        String
  senderType    String
  senderId      String?
  message       String
  attachmentUrl String?
  createdAt     DateTime    @default(now())
  supportCase   SupportCase @relation(fields: [caseId], references: [id])

  @@index([caseId, createdAt])
}

model SosEvent {
  id         String          @id @default(cuid())
  bookingId  String?
  customerId String?
  driverId   String?
  latitude   Float?
  longitude  Float?
  reason     String
  status     SosStatus       @default(CREATED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  incident   SafetyIncident?
  booking    Booking?        @relation(fields: [bookingId], references: [id])
  customer   Customer?       @relation(fields: [customerId], references: [id])
  driver     Driver?         @relation(fields: [driverId], references: [id])

  @@index([status, createdAt])
}

model SafetyIncident {
  id          String             @id @default(cuid())
  sosEventId  String?            @unique
  bookingId   String?
  customerId  String?
  driverId    String?
  type        SafetyIncidentType
  description String?
  locationLat Float?
  locationLng Float?
  status      SosStatus          @default(CREATED)
  resolution  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  actions     IncidentAction[]
  sosEvent    SosEvent?          @relation(fields: [sosEventId], references: [id])

  @@index([status, createdAt])
  @@index([bookingId, createdAt])
}

model IncidentAction {
  id         String         @id @default(cuid())
  incidentId String
  action     String
  notes      String?
  adminId    String?
  createdAt  DateTime       @default(now())
  incident   SafetyIncident @relation(fields: [incidentId], references: [id])

  @@index([incidentId, createdAt])
}

model RouteDeviationEvent {
  id           String   @id @default(cuid())
  tripId       String
  bookingId    String?
  latitude     Float?
  longitude    Float?
  deviationKm  Float?
  extraMinutes Int?
  severity     String   @default("MONITORING")
  resolved     Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([tripId, createdAt])
  @@index([bookingId, createdAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  channel   String
  title     String
  body      String
  readAt    DateTime?
  sentAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  admins          AdminUser[]
  permissionLinks RolePermission[]
}

model Permission {
  id          String           @id @default(cuid())
  module      String
  action      PermissionAction
  description String?
  createdAt   DateTime         @default(now())
  roleLinks   RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])
  role         Role       @relation(fields: [roleId], references: [id])

  @@unique([roleId, permissionId])
}

model AdminUser {
  id                String              @id @default(cuid())
  userId            String              @unique
  name              String
  approvalStatus    AdminApprovalStatus @default(PENDING)
  approvedAt        DateTime?
  approvedByAdminId String?
  createdAt         DateTime            @default(now())
  createdByAdminId  String?
  lastLoginAt       DateTime?
  rejectedAt        DateTime?
  roleId            String
  suspendedAt       DateTime?
  updatedAt         DateTime            @updatedAt
  sessions          AdminSession[]
  approvedBy        AdminUser?          @relation("AdminApprover", fields: [approvedByAdminId], references: [id])
  approvedAdmins    AdminUser[]         @relation("AdminApprover")
  createdBy         AdminUser?          @relation("AdminCreator", fields: [createdByAdminId], references: [id])
  createdAdmins     AdminUser[]         @relation("AdminCreator")
  role              Role                @relation(fields: [roleId], references: [id])
  user              User                @relation(fields: [userId], references: [id])
  auditLogs         AuditLog[]          @relation("AuditActor")

  @@index([roleId, approvalStatus])
}

model AdminSession {
  id         String    @id @default(cuid())
  adminId    String
  tokenHash  String
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId, expiresAt])
}

model AuditLog {
  id         String      @id @default(cuid())
  adminId    String?
  action     AuditAction
  module     String
  entityType String?
  entityId   String?
  beforeData Json?
  afterData  Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime    @default(now())
  admin      AdminUser?  @relation("AuditActor", fields: [adminId], references: [id])

  @@index([adminId, createdAt])
  @@index([module, entityType, entityId, createdAt])
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String?
  discountType     CouponDiscountType
  discountValue    Decimal            @db.Decimal(12, 2)
  maxDiscount      Decimal?           @db.Decimal(12, 2)
  minFare          Decimal?           @db.Decimal(12, 2)
  validFrom        DateTime
  validUntil       DateTime
  totalUsageLimit  Int?
  perCustomerLimit Int?
  rideScope        CouponRideScope    @default(ALL)
  isActive         Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bookings         Booking[]
  usages           CouponUsage[]

  @@index([isActive, validFrom, validUntil])
}

model CouponUsage {
  id         String   @id @default(cuid())
  couponId   String
  customerId String
  bookingId  String   @unique
  discount   Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())
  booking    Booking  @relation(fields: [bookingId], references: [id])
  coupon     Coupon   @relation(fields: [couponId], references: [id])
  customer   Customer @relation(fields: [customerId], references: [id])

  @@index([couponId, customerId, createdAt])
  @@index([customerId, createdAt])
}

model SystemConfiguration {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model OtpChallenge {
  id         String    @id @default(cuid())
  mobile     String
  userType   UserType
  otpHash    String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([mobile, userType, expiresAt])
  @@index([mobile, createdAt])
}

model AuthSession {
  id         String    @id @default(cuid())
  userId     String
  tokenHash  String    @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  userType   UserType
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, userType])
  @@index([expiresAt])
  @@index([revokedAt])
}

