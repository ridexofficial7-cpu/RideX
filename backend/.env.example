DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ridex"
PORT=4000
NODE_ENV=development
RIDEX_TEST_MODE=true
JWT_SECRET=REPLACED_BY_SESSION_CRYPTO_OR_LEGACY_ONLY
RIDEX_SESSION_DAYS=30
RIDEX_CONFIG_ENCRYPTION_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET
CORS_ORIGIN="http://localhost:5173"
TRUST_PROXY=false

RIDEX_COMMISSION_RATE="0.25"
SHARED_MAX_PASSENGERS="4"
SHARED_MAX_DETOUR_KM="2"
SHARED_MAX_DETOUR_PERCENT="25"
SHARED_MAX_EXTRA_TIME_MIN="10"
PICKUP_WAIT_MINUTES="2"

OSRM_BASE_URL="https://router.project-osrm.org"
ROUTING_URL="https://router.project-osrm.org"
ROUTING_TIMEOUT_MS="10000"
MATCHING_MAX_STALE_MS="120000"
MATCHING_MAX_PICKUP_DISTANCE_KM="5"
MATCHING_MAX_PICKUP_ETA_MIN="20"
MATCHING_OFFER_SECONDS="30"

# Production OTP provider. Configure through Admin > Settings after first Super Admin login.
OTP_PROVIDER_URL=
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_USERNAME=
OTP_PROVIDER_PASSWORD=
OTP_PROVIDER_SENDER_ID=
OTP_PROVIDER_TIMEOUT_MS=8000

# Optional payment provider placeholders
PAYMENT_PROVIDER_URL=
PAYMENT_PROVIDER_API_KEY=
PAYMENT_PROVIDER_USERNAME=
PAYMENT_PROVIDER_PASSWORD=

# Production Admin laptop/network allowlist (comma-separated IPs/CIDRs)
RIDEX_ADMIN_ALLOWED_IPS=203.0.113.10
